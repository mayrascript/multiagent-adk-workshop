{
  "name": "multiagent-adk-workshop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm guide:dev",
    "build": "pnpm guide:build",
    "guide:build": "node --import tsx scripts/build-guide.ts",
    "guide:dev": "pnpm guide:build && node --import tsx scripts/serve-guide.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "@types/qrcode": "1.5.6",
    "eslint": "10.14.0",
    "marked": "18.1.3",
    "qrcode": "1.5.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
